# Copy to .dev.vars for local Worker dev. NEVER commit real secrets.
# Required only from Phase 5 (notifications) onwards. Phase 1 needs none.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
# Optional threat-intel (Phase 7). Leave empty = deterministic local heuristics only.
GOOGLE_SAFE_BROWSING_API_KEY=
# WhatsApp Cloud API (Phase 9, official API only). All three required to enable.
# WHATSAPP_TOKEN is a Meta access token (treat like a password).
# WHATSAPP_PHONE_NUMBER_ID comes from the Meta App dashboard.
# WHATSAPP_TO_NUMBER is the recipient (owner alerts until subscriptions land).
# WHATSAPP_TEMPLATE_NAME is optional; without it, plain-text messages are sent
# (Meta requires pre-approved templates for business-initiated messages
# outside the 24h customer-service window).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_TEMPLATE_NAME=
# Dry run mode: discover/extract/verify/dedupe but never send messages.
DRY_RUN=true
